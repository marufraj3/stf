APP_NAME="STF Group ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Qatar

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stf_group_erp
DB_USERNAME=stf_group_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Private disk used for QID, Passport, Licence, Labour Contract and Istimara
# uploads. Files are never served directly; they stream through /api/files/{id}.
ERP_PRIVATE_DISK=local

# Sanctum / CORS: list the exact origins that host the SPA.
SANCTUM_STATEFUL_DOMAINS=your-domain.example
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# Expiry notification gateways. Leave blank to keep the mock provider active.
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
